        },
        "target_hidden_dims": {
          "description": "Hidden dimensions of the RND target network.",
          "items": {
            "type": "integer"
          },
          "title": "Target Hidden Dims",
          "type": "array"
        },
        "activation": {
          "default": "elu",
          "description": "Activation function for the RND networks.",
          "enum": [
            "elu",
            "selu",
            "relu",
            "crelu",
            "lrelu",
            "tanh",
            "sigmoid",
            "softplus",
            "gelu",
            "swish",
            "mish",
            "identity"
          ],
          "title": "Activation",
          "type": "string"
        },
        "state_normalization": {
          "default": false,
          "description": "Whether to normalize the RND state.",
          "title": "State Normalization",
          "type": "boolean"
        },
        "reward_normalization": {
          "default": false,
          "description": "Whether to normalize the RND reward.",
          "title": "Reward Normalization",
          "type": "boolean"
