                {
                  "$ref": "#/$defs/LinearWeightScheduleConfig"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Weight schedule for the RND reward.",
          "title": "Weight Schedule"
        },
        "learning_rate": {
          "default": 0.001,
          "description": "Learning rate for the RND optimizer.",
          "title": "Learning Rate",
          "type": "number"
        }
      },
      "required": [
        "num_outputs",
        "predictor_hidden_dims",
        "target_hidden_dims"
